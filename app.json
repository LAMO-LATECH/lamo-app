{
  "expo": {
    "scheme": "lamoapp",
    "experiments": {
      "typedRoutes": true
    },
    "name": "lamo-app",
    "slug": "lamo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#d9653b"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lamo uses your location to show routes to your destinations.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Lamo uses your location to show routes to your destinations."
      },
      "bundleIdentifier": "com.ciddy0.lamoapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#d9653b"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "com.ciddy0.lamoapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "@rnmapbox/maps",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lamo needs your microphone to listen for voice search.",
          "speechRecognitionPermission": "Lamo needs speech recognition to convert your voice to text."
        }
      ]
    ]
  }
}
